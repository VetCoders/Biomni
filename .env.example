# Required: LLM API Key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Biomni Agent Config
BIOMNI_LLM=claude-sonnet-4-5
BIOMNI_PATH=./data
BIOMNI_TIMEOUT_SECONDS=600

# Auth
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=7

# Server
HOST=0.0.0.0
PORT=8129

# Optional: Skip data lake download (faster startup)
BIOMNI_SKIP_DATALAKE=true
